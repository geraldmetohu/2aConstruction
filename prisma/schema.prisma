// Our own sign-in (migration 20261111120000_add_accounts). Queried with plain SQL in app/lib/auth/store.ts.
model AuthAccount {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique
  name              String    @default("")
  phone             String    @default("")
  passwordHash      String?
  emailVerifiedAt   DateTime? @db.Timestamptz(6)
  role              String    @default("CLIENT")
  trade             String?
  userId            String?
  googleSub         String?   @unique
  avatarUrl         String?
  disabledAt        DateTime? @db.Timestamptz(6)
  passwordChangedAt DateTime? @db.Timestamptz(6)
  lastLoginAt       DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @db.Timestamptz(6)
  sessions          AuthSession[]
  tokens            AuthToken[]
}
model AuthSession {
  id         String      @id
  accountId  String      @db.Uuid
  account    AuthAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt  DateTime    @default(now()) @db.Timestamptz(6)
  lastSeenAt DateTime    @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime    @db.Timestamptz(6)
  revokedAt  DateTime?   @db.Timestamptz(6)
  userAgent  String      @default("")
  ip         String      @default("")
  method     String      @default("PASSWORD")
  @@index([accountId])
}
model AuthToken {
  id        String       @id
  accountId String?      @db.Uuid
  account   AuthAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  email     String
  purpose   String
  expiresAt DateTime     @db.Timestamptz(6)
  usedAt    DateTime?    @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  @@index([email, createdAt], map: "AuthToken_email_idx")
}
model AuthAttempt {
  id  BigInt   @id @default(autoincrement())
  key String
  ok  Boolean
  at  DateTime @default(now()) @db.Timestamptz(6)
  @@index([key, at])
}

