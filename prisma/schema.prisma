// Takeoff quotes (calculator): additive tables, see migration 20261101120000_add_takeoff_quotes.
model TakeoffQuote {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference      String    @unique
  clientName     String
  clientEmail    String
  siteAddress    String    @default("")
  status         String    @default("DRAFT")
  currentVersion Int       @default(1)
  publishedVersion Int?
  sentAt         DateTime? @db.Timestamptz(6)
  acceptedAt     DateTime? @db.Timestamptz(6)
  acceptedName   String?
  createdBy      String
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @db.Timestamptz(6)
  versions       TakeoffQuoteVersion[]
  events         TakeoffQuoteEvent[]
  seen           TakeoffQuoteSeen[]
  job            TakeoffJob?
  jobStages      TakeoffJobStage[]
  jobEvents      TakeoffJobEvent[]
  jobPhotos      TakeoffJobPhoto[]
  jobActions     TakeoffJobAction[]
  jobSupplies    TakeoffJobSupply[]
  jobOrders      TakeoffJobOrder[]
  jobPayments    TakeoffJobPayment[]
  jobInvoices    TakeoffJobInvoice[]
  jobSnags       TakeoffJobSnag[]
  jobAssignments TakeoffJobAssignment[]
  checkIns       TakeoffCheckIn[]
  expenses       TakeoffExpense[]
  workerRatings  TakeoffWorkerRating[]
  @@index([clientEmail])
  @@index([updatedAt])
}
model TakeoffQuoteVersion {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId         String       @db.Uuid
  quote           TakeoffQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  version         Int
  input           Json
  result          Json
  customer        Json
  rates           Json
  prices          Json
  reason          String
  visibleToClient Boolean      @default(false)
  createdBy       String
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  @@unique([quoteId, version])
}
model TakeoffQuoteEvent {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId   String       @db.Uuid
  quote     TakeoffQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  version   Int
  kind      String
  message   String
  actor     String
  actorKind String
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  @@index([quoteId, createdAt])
}
model TakeoffQuoteSeen {
  id      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId String       @db.Uuid
  quote   TakeoffQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  viewer  String
  seenAt  DateTime     @default(now()) @db.Timestamptz(6)
  @@index([quoteId, viewer, seenAt])
}
model TakeoffRateSet {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version   Int      @unique
  overrides Json
  reason    String
  createdBy String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}
model TakeoffSupplierLink {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rateKey      String
  supplier     String
  url          String
  packQuantity Decimal  @default(1) @db.Decimal(18, 6)
  vatIncluded  Boolean  @default(true)
  active       Boolean  @default(true)
  createdBy    String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @db.Timestamptz(6)
